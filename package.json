{
  "name": "1-click-world-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Public product gallery and limited clean-room reference implementation for 1 Click World.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/demo.test.ts",
    "test:e2e": "playwright test",
    "capture:gallery": "node scripts/capture-gallery.mjs",
    "check:forbidden": "node scripts/check-public-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:forbidden"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2"
  }
}
